      "url": "./?action=now&v=5.0.2",
      "icons": [
        {
          "src": "icons/icon-192-v313.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Buscar",
      "short_name": "Buscar",
      "description": "Buscar en Organizador",
